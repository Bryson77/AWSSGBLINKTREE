{
  "name": "aws-sbg-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:email": "npm run dev --workspace=email-worker",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "build:email": "npm run build --workspace=email-worker",
    "build": "npm run build --workspaces --if-present",
    "deploy:web": "npm run deploy --workspace=web",
    "deploy:admin": "npm run deploy --workspace=admin",
    "deploy:email": "npm run deploy --workspace=email-worker",
    "deploy:all": "npm run deploy:web && npm run deploy:admin && npm run deploy:email"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.4",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3"
  }
}
