{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "awssbg-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_NOTIFICATION_EMAIL": "lethabomabilo33@gmail.com",
    "ENQUIRIES_EMAIL": "enquiries@awssbg.online",
    "NEXT_PUBLIC_SUPABASE_URL": "https://yzmgkreucvbftolijtpl.supabase.co",
    "NEXT_PUBLIC_SITE_URL": "https://awssbg.online",
    "NEXT_PUBLIC_ADMIN_URL": "https://admin.awssbg.online"
  }
  // Secrets (RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY) are stored encrypted
  // in Cloudflare — uploaded via `wrangler secret put`. No config entry needed.
}
