  // npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --config apps/email-worker/wrangler.jsonc
  "secrets": [
    "RESEND_API_KEY",
    "SUPABASE_SERVICE_ROLE_KEY"
  ]
}
